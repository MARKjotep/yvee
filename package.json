{
  "name": "yvee",
  "version": "0.1.4",
  "description": "TypeScript UI framework with reactive state, a TSX renderer, client-side routing with guards, server-side rendering, and browser storage and network helpers.",
  "keywords": [
    "typescript",
    "ui",
    "framework",
    "reactive",
    "tsx",
    "ssr",
    "routing",
    "spa",
    "indexeddb",
    "websockets"
  ],
  "author": "Marky <markjotep@gmail.com>",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "init": "bun update && mkdir -p ./src ./dist  ./types && {  [ ! -f ./src/index.ts ] && touch ./src/index.ts; }",
    "test": "bun test",
    "test:browser": "playwright test",
    "test:types": "tsc --noEmit -p tsconfig.consumer.json",
    "demo": "bun run test/yvee-bun/server.ts",
    "build": "bun builder.ts",
    "prepublishOnly": "bun test && bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MARKjotep/yvee.git"
  },
  "bugs": {
    "url": "https://github.com/MARKjotep/yvee/issues"
  },
  "homepage": "https://github.com/MARKjotep/yvee#readme",
  "dependencies": {},
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@ohmyqt/oven": "link:@ohmyqt/oven",
    "@ohmyqt/u": "link:@ohmyqt/u",
    "@playwright/test": "^1.65.1",
    "@types/bun": "^1.4.4",
    "fake-indexeddb": "^6.2.8",
    "typescript": "5.9.3"
  },
  "peerDependencies": {},
  "directories": {
    "test": "test"
  },
  "type": "module"
}
